# Copy this file to .env. Leave unused integrations blank; they show as disabled.
# Censys Platform Personal Access Token: https://accounts.censys.io/settings/personal-access-tokens
CENSYS_TOKEN=
MY_PUBLIC_IP=
# Optional: use your organization's entitlements instead of the free account.
CENSYS_ORGANIZATION_ID=

# XposedOrNot email breach checks are free; no API key is needed.
MY_EMAILS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
