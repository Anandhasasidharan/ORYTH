{
  "title": "ORYTH — Personal Cyber Risk Dashboard",
  "style": "dark",
  "panels": [
    {
      "type": "stat",
      "title": "Open Ports (Censys)",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [{"expr": "censys_open_ports_total or on() vector(0)", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus-Censys"},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        }
      },
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    {
      "type": "stat",
      "title": "Censys Risk Score",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "targets": [{"expr": "censys_risk_score or on() vector(0)", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus-Censys"},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 6}]},
          "max": 10
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Email Breaches",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "targets": [{"expr": "sum(hibp_breaches_total) or on() vector(0)", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus-HIBP"},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        }
      }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "version": 1
}