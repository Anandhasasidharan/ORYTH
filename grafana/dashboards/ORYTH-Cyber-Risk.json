{
  "uid": "oryth-cyber-risk",
  "title": "ORYTH \u2014 Personal Cyber Risk Dashboard",
  "tags": [
    "oryth",
    "security"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Open Ports (Censys)",
      "description": "Distinct port numbers observed by Censys. Missing/indexing/API failures remain unknown. Observations are not a live port scan.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "oryth-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "censys_open_ports_total and on(job) (censys_scrape_success == 1) and on(job) (up{job=\"censys\"} == 1)",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{email}}",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
